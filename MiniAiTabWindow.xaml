<Window x:Class="MyOverlayPOC.MiniAiTabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="460" Height="68"
        MinWidth="380" MinHeight="68"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="MiniCtrlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9AA0A6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#35363A"/>
                                <Setter Property="Foreground" Value="#E8EAED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniCloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9AA0A6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#D93025"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ScrollBar -->
        <Style x:Key="MiniScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Focusable" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border CornerRadius="3" Background="#5F6368"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid>
                                    <Border Background="#202124" CornerRadius="3"/>
                                    <Track Name="PART_Track" IsDirectionReversed="true">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource MiniScrollThumbStyle}" Margin="1,0,1,0"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MiniScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/>
                            <ScrollBar Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Style="{StaticResource MiniScrollBarStyle}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="#202124"
            BorderBrush="#3C4043"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Top Bar & Search Omnibox (Pure Search Bar, No Tabs) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Expandable Instant Answer Panel -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Search Area -->
            <Border Grid.Row="0" Padding="8,4,8,6" Background="#202124">
                <StackPanel>
                    <!-- Header Info Row with 'by div' Signature -->
                    <DockPanel LastChildFill="True" Margin="2,0,2,3">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Instant Transparent Mode Button (Shift+T) -->
                            <Button x:Name="BtnTransparency" Style="{StaticResource MiniCtrlBtn}" Padding="4,2" Margin="0,0,2,0" ToolTip="Instant Transparent Ghost Mode (Shift+T)" Click="BtnTransparency_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="👻" FontSize="10" Margin="0,0,2,0"/>
                                    <TextBlock Text="Ghost (Shift+T)" FontSize="9.5" FontWeight="SemiBold" Foreground="#8AB4F8"/>
                                </StackPanel>
                            </Button>
                            <!-- Google Lens Capture Button -->
                            <Button x:Name="BtnLens" Style="{StaticResource MiniCtrlBtn}" Padding="4,2" Margin="0,0,2,0" ToolTip="Google Lens: 1-Click Screen Capture &amp; Ask" Click="BtnLens_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📷" FontSize="10" Margin="0,0,2,0"/>
                                    <TextBlock Text="Lens" FontSize="9.5" FontWeight="SemiBold" Foreground="#34A853"/>
                                </StackPanel>
                            </Button>
                            <!-- Restore Full Window Button -->
                            <Button x:Name="BtnRestoreFull" Style="{StaticResource MiniCtrlBtn}" Padding="4,2" Margin="0,0,2,0" ToolTip="Restore Full Window (Shift+C)" Click="BtnRestoreFull_Click">
                                <TextBlock Text="⛶" FontSize="10" Foreground="#9AA0A6"/>
                            </Button>
                            <!-- Close / Hide Button -->
                            <Button x:Name="BtnClose" Style="{StaticResource MiniCloseBtn}" Padding="4,2" ToolTip="Close (Esc)" Click="BtnClose_Click">
                                <TextBlock Text="✕" FontSize="9"/>
                            </Button>
                        </StackPanel>

                        <!-- Brand, Signature & Stealth Tags -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="G" FontSize="12" FontWeight="Bold" Foreground="#4285F4"/>
                                <TextBlock Text="o" FontSize="12" FontWeight="Bold" Foreground="#EA4335"/>
                                <TextBlock Text="o" FontSize="12" FontWeight="Bold" Foreground="#FBBC05"/>
                                <TextBlock Text="g" FontSize="12" FontWeight="Bold" Foreground="#4285F4"/>
                                <TextBlock Text="l" FontSize="12" FontWeight="Bold" Foreground="#34A853"/>
                                <TextBlock Text="e" FontSize="12" FontWeight="Bold" Foreground="#EA4335"/>
                                <TextBlock Text=" AI" FontSize="10" FontWeight="Bold" Foreground="#8AB4F8" Margin="2,0,0,0"/>
                            </StackPanel>
                            <!-- User's Signature: by div -->
                            <Border Background="#2B1A3D" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Signature: by div">
                                <TextBlock Text="by div" FontSize="8" FontWeight="Bold" Foreground="#C084FC" FontFamily="Segoe UI, Consolas"/>
                            </Border>
                            <Border Background="#1E3A2F" BorderBrush="#34A853" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,4,0" VerticalAlignment="Center">
                                <TextBlock Text="GEMINI" FontSize="8" FontWeight="Bold" Foreground="#34A853" FontFamily="Segoe UI, Consolas"/>
                            </Border>
                            <Border Background="#1A2D42" BorderBrush="#8AB4F8" BorderThickness="1" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                <TextBlock Text="🛡️ STEALTH" FontSize="8" FontWeight="Bold" Foreground="#8AB4F8" FontFamily="Segoe UI, Consolas"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- Attached Screens Preview Tray (Multi-Screenshot Support) -->
                    <Border x:Name="LensAttachmentBar" Visibility="Collapsed" Background="#292A2D" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,2,0,4">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnAddAnotherScreen" Style="{StaticResource MiniCtrlBtn}" Background="#1E3A2F" BorderBrush="#34A853" BorderThickness="1" Padding="6,2" Margin="0,0,4,0" ToolTip="Capture another screen into this question" Click="BtnAddAnotherScreen_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontSize="11" FontWeight="Bold" Foreground="#34A853" Margin="0,0,3,0"/>
                                        <TextBlock Text="Add Screen" FontSize="9.5" Foreground="#34A853" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnClearAllScreens" Style="{StaticResource MiniCtrlBtn}" Padding="4,2" ToolTip="Remove all attached screenshots" Click="BtnClearAllScreens_Click">
                                    <TextBlock Text="✕ Clear" FontSize="9" Foreground="#9AA0A6"/>
                                </Button>
                            </StackPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                                <StackPanel x:Name="AttachedScreensPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Google AI Omnibox Search Bar (Compact) -->
                    <Border Background="#303134" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="16" Padding="4,1" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Sparkle Icon -->
                            <TextBlock Grid.Column="0" Text="✨" FontSize="11" Foreground="#8AB4F8" VerticalAlignment="Center" Margin="6,0,4,0"/>

                            <!-- Input Box & Placeholder -->
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <TextBox x:Name="SearchBox"
                                         Background="Transparent"
                                         Foreground="#FFFFFF"
                                         BorderThickness="0"
                                         CaretBrush="#8AB4F8"
                                         FontSize="11.5"
                                         Padding="3,4"
                                         VerticalContentAlignment="Center"
                                         AcceptsReturn="False"
                                         KeyDown="SearchBox_KeyDown"
                                         PreviewKeyDown="SearchBox_PreviewKeyDown"
                                         TextChanged="SearchBox_TextChanged"/>
                                <TextBlock x:Name="SearchPlaceholder"
                                           Text="Ask Gemini — code, questions, or screenshots"
                                           Foreground="#9AA0A6"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Margin="4,0,0,0"
                                           FontSize="11.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                             <Setter Property="Visibility" Value="Collapsed"/>
                                             <Style.Triggers>
                                                 <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                     <Setter Property="Visibility" Value="Visible"/>
                                                 </DataTrigger>
                                             </Style.Triggers>
                                         </Style>
                                     </TextBlock.Style>
                                 </TextBlock>
                            </Grid>

                            <!-- Clear Button -->
                            <Button x:Name="BtnClearSearch" Grid.Column="2" Style="{StaticResource MiniCtrlBtn}" Width="20" Height="20" Margin="0,0,2,0" ToolTip="Clear" Click="BtnClearSearch_Click" Visibility="Collapsed">
                                <TextBlock Text="✕" FontSize="9" Foreground="#9AA0A6"/>
                            </Button>

                            <Button Grid.Column="4" Content="Web" ToolTip="Gemini website: no API key. Google controls signed-out features." Style="{StaticResource MiniCtrlBtn}" FontSize="10" Click="OpenGeminiWeb_Click"/>
                            <!-- Ask AI Search Pill Button -->
                            <Button x:Name="BtnAskAi" Grid.Column="3" Content="Ask" ToolTip="Uses your saved Gemini key; opens Gemini Web if no key is configured" Style="{StaticResource MiniCtrlBtn}" Padding="9,3" Margin="1"
                                    Background="#1A73E8" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10.5" Click="BtnAskAi_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#1765CC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Autocomplete Suggestions Dropdown Popup -->
            <Popup x:Name="SuggestionsPopup"
                   PlacementTarget="{Binding ElementName=SearchBox}"
                   Placement="Bottom"
                   IsOpen="False"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="Fade">
                <Border Background="#292A2D" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="8" Margin="0,3,0,0" MinWidth="380">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.5"/>
                    </Border.Effect>
                    <ItemsControl x:Name="SuggestionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="SugItem" Background="Transparent" CornerRadius="5" Padding="8,5" Margin="2,1" Cursor="Hand" MouseLeftButtonDown="SuggestionItem_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍" FontSize="10" Foreground="#9AA0A6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="#E8EAED" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger Property="Border.IsMouseOver" Value="True">
                                        <Setter TargetName="SugItem" Property="Background" Value="#35363A"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>

            <Border x:Name="GeminiPanel" Grid.Row="1" Visibility="Collapsed" Background="#202124" BorderBrush="#3C4043" BorderThickness="0,1,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="8,6">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Copy question" Style="{StaticResource MiniCtrlBtn}" Click="CopyGeminiQuestion_Click"/>
                                <Button Content="Copy image" Style="{StaticResource MiniCtrlBtn}" Click="CopyGeminiImage_Click"/>
                                <Button Content="New chat" Style="{StaticResource MiniCtrlBtn}" Click="NewGeminiChat_Click"/>
                                <Button Content="Reload" Style="{StaticResource MiniCtrlBtn}" Click="ReloadGemini_Click"/>
                                <Button Content="Collapse" Style="{StaticResource MiniCtrlBtn}" Click="BtnCollapse_Click"/>
                            </StackPanel>
                            <TextBlock Text="Gemini · Private session" Foreground="#8AB4F8" FontSize="11" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="GeminiStatus" Text="Loading Gemini..." TextWrapping="Wrap" Foreground="#BDC1C6" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Grid x:Name="GeminiBrowserHost" Background="#131314"/>
                </DockPanel>
            </Border>

            <!-- ROW 1: DIRECT INSTANT ANSWER CARD (NO EXTRA TABS) -->
            <Border x:Name="ResultsPanel" Grid.Row="1" Visibility="Collapsed" Background="#202124" BorderBrush="#3C4043" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Top Action Controls Strip -->
                        <RowDefinition Height="30"/>
                        <!-- Results Scrollable Area -->
                        <RowDefinition Height="*"/>
                        <!-- Bottom Follow-Up "Ask anything" Search Bar -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Action Controls Strip -->
                    <Border Grid.Row="0" Background="#292A2D" BorderBrush="#3C4043" BorderThickness="0,0,0,1" Padding="8,0">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnCopy" Style="{StaticResource MiniCtrlBtn}" Padding="6,2" FontSize="9.5" ToolTip="Copy AI Answer" Click="BtnCopy_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋" FontSize="9.5" Margin="0,0,3,0"/>
                                        <TextBlock Text="Copy" FontSize="9.5" Foreground="#E8EAED"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnCollapse" Style="{StaticResource MiniCtrlBtn}" Padding="6,2" FontSize="9.5" ToolTip="Collapse to Search Bar" Click="BtnCollapse_Click">
                                    <TextBlock Text="▲ Collapse" FontSize="9.5" Foreground="#9AA0A6"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✨" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <ComboBox x:Name="MiniGeminiModel" Width="155" Margin="0,0,6,0" FontSize="10" ToolTip="Model for Gemini API answers"/>
                                <TextBlock x:Name="AnswerHeader" Text="Gemini" FontSize="10.5" FontWeight="SemiBold" Foreground="#8AB4F8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Content Area -->
                    <Grid Grid.Row="1" Background="#202124">
                        <!-- Loading State -->
                        <StackPanel x:Name="LoadingIndicator" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <TextBlock Text="✨" FontSize="26" HorizontalAlignment="Center" Foreground="#8AB4F8" Margin="0,0,0,8"/>
                            <TextBlock Text="Waiting for Gemini..." FontSize="12" FontWeight="SemiBold" Foreground="#E8EAED" HorizontalAlignment="Center"/>
                            <TextBlock Text="Using your configured Gemini API key" FontSize="10" Foreground="#34A853" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Answer Scrollable Area -->
                        <ScrollViewer x:Name="AnswerScrollViewer" Style="{StaticResource MiniScrollViewerStyle}" Padding="12,10" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="AnswerContentPanel">
                                <!-- Primary Initial Answer Card -->
                                <Border x:Name="PrimaryAnswerCard" Background="#292A2D" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                            <Border DockPanel.Dock="Right" Background="#1E3A2F" BorderBrush="#34A853" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                                <TextBlock Text="GEMINI API" FontSize="8" FontWeight="Bold" Foreground="#34A853"/>
                                            </Border>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✨" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Gemini response" FontSize="11" FontWeight="SemiBold" Foreground="#E8EAED" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBox x:Name="AnswerBodyText"
                                                 Background="Transparent"
                                                 Foreground="#E8EAED"
                                                 BorderThickness="0"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 FontSize="12"
                                                 FontFamily="Consolas"
                                                 CaretBrush="#8AB4F8"/>
                                    </StackPanel>
                                </Border>

                                <!-- Dynamic Follow-Up Conversation Thread -->
                                <StackPanel x:Name="FollowUpMessagesPanel"/>

                                <!-- Bottom Quick Actions -->
                                <WrapPanel Margin="2,0,2,6">
                                    <Button x:Name="BtnAskScreen" Style="{StaticResource MiniCtrlBtn}" Background="#292A2D" BorderBrush="#3C4043" BorderThickness="1" Padding="10,4" Margin="0,0,6,4" Click="BtnLens_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📷" FontSize="11" Margin="0,0,5,0"/>
                                            <TextBlock Text="Capture Screen &amp; Ask" FontSize="11" Foreground="#34A853"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnGhostAction" Style="{StaticResource MiniCtrlBtn}" Background="#292A2D" BorderBrush="#3C4043" BorderThickness="1" Padding="10,4" Margin="0,0,6,4" Click="BtnTransparency_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="👻" FontSize="11" Margin="0,0,5,0"/>
                                            <TextBlock Text="Ghost Mode (Shift+T)" FontSize="11" Foreground="#8AB4F8"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ROW 2: GOOGLE GEMINI "Ask anything" FOLLOW-UP BAR & MULTI-SCREEN TRAY -->
                    <Border Grid.Row="2" Background="#202124" BorderBrush="#3C4043" BorderThickness="0,1,0,0" Padding="10,6,10,8">
                        <StackPanel>
                            <!-- Follow-Up Multi-Screenshot Attachment Tray -->
                            <Border x:Name="FollowUpAttachmentBar" Visibility="Collapsed" Background="#292A2D" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,0,6">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnFollowUpAddScreen" Style="{StaticResource MiniCtrlBtn}" Background="#1E3A2F" BorderBrush="#34A853" BorderThickness="1" Padding="6,2" Margin="0,0,4,0" ToolTip="Capture another screen into this question" Click="BtnAddAnotherScreen_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="+" FontSize="11" FontWeight="Bold" Foreground="#34A853" Margin="0,0,3,0"/>
                                                <TextBlock Text="Add Screen" FontSize="9.5" Foreground="#34A853" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnFollowUpClearScreens" Style="{StaticResource MiniCtrlBtn}" Padding="4,2" ToolTip="Remove all attached screenshots" Click="BtnClearAllScreens_Click">
                                            <TextBlock Text="✕ Clear" FontSize="9" Foreground="#9AA0A6"/>
                                        </Button>
                                    </StackPanel>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                                        <StackPanel x:Name="FollowUpScreensPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <Border Background="#303134" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="18" Padding="4,3,8,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Plus button on left (Google Lens 1-click screen capture) -->
                                    <Button x:Name="BtnFollowUpPlus" Grid.Column="0" Width="26" Height="26" Margin="2,0,6,0" ToolTip="Google Lens: Capture Screen &amp; Ask" Click="BtnFollowUpPlus_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="pb" Background="#3C4043" CornerRadius="13" Cursor="Hand">
                                                    <TextBlock Text="+" FontSize="15" FontWeight="SemiBold" Foreground="#E8EAED" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="pb" Property="Background" Value="#5F6368"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Input Box & Placeholder -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox x:Name="FollowUpBox"
                                                 Background="Transparent"
                                                 Foreground="#FFFFFF"
                                                 BorderThickness="0"
                                                 CaretBrush="#8AB4F8"
                                                 FontSize="12"
                                                 Padding="3,4"
                                                 VerticalContentAlignment="Center"
                                                 AcceptsReturn="False"
                                                 KeyDown="FollowUpBox_KeyDown"
                                                 PreviewKeyDown="FollowUpBox_PreviewKeyDown"/>
                                        <TextBlock x:Name="FollowUpPlaceholder"
                                                   Text="Ask anything"
                                                   Foreground="#9AA0A6"
                                                   IsHitTestVisible="False"
                                                   VerticalAlignment="Center"
                                                   Margin="5,0,0,0"
                                                   FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=FollowUpBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Right Action: Sparkle Send Button -->
                                    <Button x:Name="BtnFollowUpSend" Grid.Column="2" Width="26" Height="26" Margin="4,0,0,0" ToolTip="Send (Enter)" Click="BtnFollowUpSend_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="sb" Background="#1A73E8" CornerRadius="13" Cursor="Hand">
                                                    <TextBlock Text="✨" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="sb" Property="Background" Value="#1765CC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- VIEW 4: MONITOR -->
                                <ScrollViewer x:Name="PanelMonitor" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Style="{StaticResource DarkThinScrollViewerStyle}">
                                    <StackPanel Margin="6,0,6,6">
                                        <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <DockPanel>
                                                <TextBlock Text="SAMPLING: 1000ms" Foreground="{DynamicResource Theme.TextMuted}" FontSize="9" FontFamily="JetBrains Mono, Consolas" DockPanel.Dock="Right"/>

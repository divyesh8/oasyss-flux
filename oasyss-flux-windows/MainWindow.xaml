                                            <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="4,4,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Proctored Assessment" Foreground="{DynamicResource Theme.TextPrimary}" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="Screen share invisibility, click pass-through (Shift+T)." Foreground="{DynamicResource Theme.TextSecondary}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- VIEW 6: EVENT LOG -->
                                <ScrollViewer x:Name="PanelEventLog" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Style="{StaticResource DarkThinScrollViewerStyle}">
                                    <StackPanel Margin="6,0,6,6">
                                        <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="EVENT LOG" Foreground="{DynamicResource Theme.TextPrimary}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="AUDIT TRAIL &amp; KERNEL INTEROP EVENTS" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="10" FontFamily="JetBrains Mono, Consolas" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="09:07:16.102  [SYS]   Oasyss Flux core engine initialized (Win64)" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="10" FontFamily="JetBrains Mono, Consolas" Margin="0,2"/>
                                                <TextBlock Text="09:07:16.124  [SYS]   Loaded cryptographic provider: AES-256-GCM / SHA-256 HMAC" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="10" FontFamily="JetBrains Mono, Consolas" Margin="0,2"/>

                                                <DockPanel Margin="0,0,0,12">
                                                    <Border Width="48" Height="48" CornerRadius="6" Background="{DynamicResource Theme.SurfaceAlt}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" Margin="0,0,12,0">
                                                        <Image Source="./logo.png" Stretch="UniformToFill"/>

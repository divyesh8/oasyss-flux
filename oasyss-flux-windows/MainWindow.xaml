<Window x:Class="MyOverlayPOC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:MyOverlayPOC"
        mc:Ignorable="d"
        Title=""
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Cursor="Arrow">

    <Window.Resources>
        <Style x:Key="ScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Focusable" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border CornerRadius="4" Background="{DynamicResource Theme.ScrollThumb}" BorderBrush="Transparent" BorderThickness="0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.DialogBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="DialogLabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#D6FF3F"/>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.SurfacePressed}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#D6FF3F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Theme.Input}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#D6FF3F"/>
            <Setter Property="SelectionBrush" Value="#272E36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#D6FF3F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="DialogCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="checkBoxBorder"
                                     Width="18" Height="18"
                                     BorderBrush="{DynamicResource Theme.Border}"
                                     Background="{DynamicResource Theme.Input}"
                                     BorderThickness="1"
                                     CornerRadius="3">
                                <TextBlock x:Name="checkMark" Text="✔"
                                           Foreground="#D6FF3F"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-3,0,0" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#D6FF3F"/>
                            </Trigger>
                             <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#D6FF3F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="0,8,0,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B60F1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Focusable" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkThinScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="0.00001*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="{DynamicResource Theme.ScrollTrack}" CornerRadius="4"/>
                                    <Track Name="PART_Track" Grid.Row="0" IsDirectionReversed="true">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="ScrollBar.PageUpCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumbStyle}" Margin="1,0,1,0" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="ScrollBar.PageDownCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkThinScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}" />
                            <ScrollBar Name="PART_VerticalScrollBar"
                                       Grid.Column="1" Grid.Row="0"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Style="{StaticResource DarkThinScrollBarStyle}"/>
                            <ScrollBar Name="PART_HorizontalScrollBar"
                                       Grid.Column="0" Grid.Row="1"
                                       Orientation="Horizontal"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       Style="{StaticResource DarkThinScrollBarStyle}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Theme.SurfacePressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
<Style x:Key="TabCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="2">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
                    <Setter Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoadingSpinnerStyle" TargetType="Image">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                From="0"
                                To="360"
                                Duration="0:0:1.5"
                                RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Inter, Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.SurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chrome Browser Mode Window Controls -->
        <Style x:Key="ChromeWindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#3C4043"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#5F6368"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeWindowCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E81123"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#BF0F1D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeGeminiButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2B2D30"/>
            <Setter Property="BorderBrush" Value="#444746"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#383A3E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#5E6166"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#45474D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeTabstripButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9AA0A6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#35363A"/>
                                <Setter Property="Foreground" Value="#E8EAED"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444746"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9AA0A6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#35363A"/>
                                <Setter Property="Foreground" Value="#E8EAED"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444746"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainOverlayBorder" Padding="15" Background="{DynamicResource Theme.AppBackground}" CornerRadius="8" BorderBrush="{DynamicResource Theme.AppBorder}" BorderThickness="1">
        <TabControl x:Name="BrowserTabs" BorderThickness="0" SelectionChanged="BrowserTabs_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    
                    <Setter Property="AllowDrop" Value="True" />
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TabItem_PreviewMouseLeftButtonDown" />
                    <EventSetter Event="PreviewMouseMove" Handler="TabItem_PreviewMouseMove" />
                    <EventSetter Event="Drop" Handler="TabItem_Drop" />
                    
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Grid x:Name="templateRoot"
                                      Height="34"
                                      Margin="0,0,2,0"
                                      MinWidth="120"
                                      MaxWidth="240"
                                      ClipToBounds="True">

                                    <Border x:Name="DropSeparator"
                                            Width="2"
                                            Background="#8AB4F8"
                                            HorizontalAlignment="Left"
                                            Margin="0,5,0,5"
                                            CornerRadius="1"
                                            Visibility="Collapsed"
                                            Opacity="1.0" />

                                    <Border x:Name="tabBorder"
                                            Background="Transparent" 
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="8,8,0,0">
                                    </Border>

                                    <ContentPresenter x:Name="contentPresenter"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"
                                                      Margin="10,0,10,0"/>
                                </Grid>
                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource Theme.TabSelectedBg}"/>
                                        <Setter TargetName="tabBorder" Property="BorderThickness" Value="0"/>
                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="Transparent"/>
                                    </Trigger>
    
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource Theme.TabHover}"/>
                                    </Trigger>
    
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                             <Condition Property="IsSelected" Value="True"/>
                                             <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource Theme.TabSelectedBg}"/>
                                        <Setter TargetName="tabBorder" Property="BorderThickness" Value="0"/>
                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="Transparent"/>
                                    </MultiTrigger>

                                    <DataTrigger Binding="{Binding IsDragOver, RelativeSource={RelativeSource Self}}" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource Theme.SurfaceHover}" />
                                        <Setter TargetName="tabBorder" Property="BorderThickness" Value="1"/>
                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="#8AB4F8" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding IsTabDragging, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter TargetName="DropSeparator" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabControl.Template>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ROW 0: TOP WINDOW CHROME -->
                        <Border x:Name="FluxTopBar" Grid.Row="0" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1" Padding="8,4" Margin="0,0,0,6">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="MuteStatusTextBlock"
                                               Text="Muted"
                                               VerticalAlignment="Center"
                                               Margin="0,0,5,0"
                                               Foreground="{DynamicResource Theme.TextPrimary}"/>
                                    <StackPanel x:Name="RecordingStatusIndicator" 
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0"
                                                Visibility="Collapsed">
                                        <Ellipse Width="8" Height="8" Fill="Red" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RecordingTimerTextBlock" 
                                                   Text="00:00"
                                                   Foreground="{DynamicResource Theme.TextPrimary}"
                                                   Margin="5,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="TopModeToggleButton" Margin="0,0,8,0" Style="{StaticResource ModernButtonStyle}" Padding="8,2" Height="26" ToolTip="Toggle Full Browser Mode (Shift+B)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TopModeIcon" Text="🌐" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TopModeText" Text="BROWSER" FontSize="9" FontWeight="SemiBold" FontFamily="JetBrains Mono, Consolas" Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="MuteButtonInTemplate" Margin="0,0,5,0" Style="{StaticResource ModernButtonStyle}" Width="26" Height="26">
                                        <Image Source="./muted.png" Height="14" />
                                    </Button>
                                    <Button x:Name="MinimizeButton" Margin="0,0,5,0" Width="26" Height="26" Style="{StaticResource ModernButtonStyle}">
                                        <Image Source="./minimize.png" Height="14" />
                                    </Button>
                                    <Button x:Name="ExitButton" Margin="0,0,0,0" Width="26" Height="26" Style="{StaticResource ModernButtonStyle}">
                                        <Image Source="./x.png" Height="14" />
                                    </Button>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="20" Height="20" CornerRadius="3" Background="{DynamicResource Theme.SurfaceAlt}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" Margin="0,0,6,0">
                                        <Image Source="./logo.png" Stretch="UniformToFill"/>
                                    </Border>
                                    <TextBlock Text="OASYSS FLUX" Foreground="{DynamicResource Theme.TextPrimary}" FontWeight="SemiBold" FontSize="11" FontFamily="Segoe UI Variable, Inter, Segoe UI" VerticalAlignment="Center"/>
                                    <TextBlock Text="/" Foreground="{DynamicResource Theme.TextMuted}" FontSize="10" Margin="6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="DIVYESH EDITION" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="9" FontFamily="JetBrains Mono, Consolas" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource Theme.SurfaceAlt}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="WIN64" Foreground="{DynamicResource Theme.TextMuted}" FontSize="8" FontFamily="JetBrains Mono, Consolas"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- ROW 1: WORKSPACE WITH SIDEBAR -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="SidebarColumn" Width="175"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- COLUMN 0: NARROW SIDEBAR -->
                            <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="6,8" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Mini Brand -->
                                    <StackPanel Grid.Row="0" Margin="4,0,4,10">
                                        <TextBlock Text="NAVIGATION" Foreground="{DynamicResource Theme.TextMuted}" FontSize="8" FontWeight="SemiBold" FontFamily="JetBrains Mono, Consolas"/>
                                    </StackPanel>

                                    <!-- Navigation Links -->
                                    <StackPanel Grid.Row="1">
                                        <Button x:Name="BtnSidebarToggleBrowserMode" Style="{StaticResource ModernButtonStyle}" Margin="0,0,0,8" Padding="6,4" ToolTip="Toggle Full Browser Mode (Shift+B)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="SidebarBrowserModeIcon" Text="🌐" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="SidebarBrowserModeText" Text="BROWSER MODE" FontSize="9" FontWeight="SemiBold" FontFamily="JetBrains Mono, Consolas" Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnNavOverview" Content="OVERVIEW" Style="{StaticResource SidebarButtonStyle}" Margin="0,1"/>
                                        <Button x:Name="BtnNavSessions" Content="SESSIONS" Style="{StaticResource SidebarButtonStyle}" Margin="0,1"/>
                                        <Button x:Name="BtnNavAnalysis" Content="ANALYSIS" Style="{StaticResource SidebarButtonStyle}" Margin="0,1"/>
                                        <Button x:Name="BtnNavMonitor" Content="MONITOR" Style="{StaticResource SidebarButtonStyle}" Margin="0,1"/>
                                        <Button x:Name="BtnNavProfiles" Content="PROFILES" Style="{StaticResource SidebarButtonStyle}" Margin="0,1"/>
                                        <Button x:Name="BtnNavEventLog" Content="EVENT LOG" Style="{StaticResource SidebarButtonStyle}" Margin="0,1"/>
                                        <Button x:Name="BtnNavSettings" Content="SETTINGS" Style="{StaticResource SidebarButtonStyle}" Margin="0,1"/>
                                        <Button x:Name="BtnNavAbout" Content="ABOUT" Style="{StaticResource SidebarButtonStyle}" Margin="0,1"/>
                                    </StackPanel>

                                    <!-- Bottom System State -->
                                    <Border Grid.Row="2" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0" Padding="4,8,4,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="#D6FF3F" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="SYSTEM READY" Foreground="{DynamicResource Theme.TextPrimary}" FontSize="9" FontWeight="SemiBold" FontFamily="JetBrains Mono, Consolas"/>
                                            </StackPanel>
                                            <TextBlock Text="LOCAL MODE | v1.0.0" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="8" FontFamily="JetBrains Mono, Consolas" Margin="12,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- COLUMN 1: WORKSPACE VIEWS -->
                            <Grid Grid.Column="1">
                                <!-- VIEW 1: OVERVIEW -->
                                <ScrollViewer x:Name="PanelOverview" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Style="{StaticResource DarkThinScrollViewerStyle}">
                                    <StackPanel Margin="6,0,6,6">
                                        <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <DockPanel>
                                                <Button x:Name="BtnOverviewOpenSession" DockPanel.Dock="Right" Content="OPEN SESSION WORKSPACE →" Style="{StaticResource DialogButtonStyle}" FontSize="10" Padding="10,4"/>
                                                <StackPanel>
                                                    <TextBlock Text="SYSTEM OVERVIEW" Foreground="{DynamicResource Theme.TextPrimary}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Text="LOCAL SECURITY WORKSPACE / DIVYESH EDITION" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="10" FontFamily="JetBrains Mono, Consolas" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- 4 Restrained Status Cards -->
                                        <UniformGrid Columns="4" Margin="0,0,0,8">
                                            <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="● R3" Foreground="#D6FF3F" FontSize="9" FontFamily="JetBrains Mono, Consolas" DockPanel.Dock="Right"/>
                                                        <TextBlock Text="SUBSYSTEM" Foreground="{DynamicResource Theme.TextMuted}" FontSize="9" FontFamily="JetBrains Mono, Consolas"/>
                                                    </DockPanel>
                                                    <TextBlock Text="ONLINE" Foreground="{DynamicResource Theme.TextPrimary}" FontWeight="SemiBold" FontSize="16" Margin="0,6,0,0"/>
                                                    <TextBlock Text="0.2ms Loopback latency" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="9" FontFamily="JetBrains Mono, Consolas"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="2,0,2,0">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="● ACTIVE" Foreground="#D6FF3F" FontSize="9" FontFamily="JetBrains Mono, Consolas" DockPanel.Dock="Right"/>
                                                        <TextBlock Text="WORKSPACE" Foreground="{DynamicResource Theme.TextMuted}" FontSize="9" FontFamily="JetBrains Mono, Consolas"/>
                                                    </DockPanel>
                                                    <TextBlock Text="READY" Foreground="{DynamicResource Theme.TextPrimary}" FontWeight="SemiBold" FontSize="16" Margin="0,6,0,0"/>
                                                    <TextBlock Text="FLX-8821-LOC context" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="9" FontFamily="JetBrains Mono, Consolas"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="2,0,2,0">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="● OK" Foreground="#D6FF3F" FontSize="9" FontFamily="JetBrains Mono, Consolas" DockPanel.Dock="Right"/>
                                                        <TextBlock Text="ENGINE" Foreground="{DynamicResource Theme.TextMuted}" FontSize="9" FontFamily="JetBrains Mono, Consolas"/>
                                                    </DockPanel>
                                                    <TextBlock Text="READY" Foreground="{DynamicResource Theme.TextPrimary}" FontWeight="SemiBold" FontSize="16" Margin="0,6,0,0"/>
                                                    <TextBlock Text="v1.0.0-RELEASE (Win64)" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="9" FontFamily="JetBrains Mono, Consolas"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="4,0,0,0">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="● SEC" Foreground="#D6FF3F" FontSize="9" FontFamily="JetBrains Mono, Consolas" DockPanel.Dock="Right"/>
                                                        <TextBlock Text="AFFINITY" Foreground="{DynamicResource Theme.TextMuted}" FontSize="9" FontFamily="JetBrains Mono, Consolas"/>
                                                    </DockPanel>
                                                    <TextBlock Text="LOCAL" Foreground="{DynamicResource Theme.TextPrimary}" FontWeight="SemiBold" FontSize="16" Margin="0,6,0,0"/>
                                                    <TextBlock Text="WDA_EXCLUDE active" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="9" FontFamily="JetBrains Mono, Consolas"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <!-- Subsystem Security Status -->
                                        <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock Text="ALL BOUNDARIES VERIFIED" Foreground="{DynamicResource Theme.TextMuted}" FontSize="9" FontFamily="JetBrains Mono, Consolas" DockPanel.Dock="Right"/>
                                                    <TextBlock Text="SECURITY SUBSYSTEM STATUS" Foreground="{DynamicResource Theme.TextPrimary}" FontWeight="SemiBold" FontSize="11"/>
                                                </DockPanel>
                                                <UniformGrid Columns="2">
                                                    <Border Background="{DynamicResource Theme.SurfaceAlt}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,4,4">
                                                        <DockPanel>
                                                            <TextBlock Text="ENFORCED (Level 2)" Foreground="#D6FF3F" FontSize="10" FontFamily="JetBrains Mono, Consolas" DockPanel.Dock="Right"/>
                                                            <TextBlock Text="Display Affinity Guard" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="10"/>
                                                        </DockPanel>
                                                    </Border>
                                                    <Border Background="{DynamicResource Theme.SurfaceAlt}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="4,0,0,4">
                                                        <DockPanel>
                                                            <TextBlock Text="NON-PAGEABLE" Foreground="{DynamicResource Theme.TextPrimary}" FontSize="10" FontFamily="JetBrains Mono, Consolas" DockPanel.Dock="Right"/>
                                                            <TextBlock Text="Memory Workspace" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="10"/>
                                                        </DockPanel>
                                                    </Border>
                                                    <Border Background="{DynamicResource Theme.SurfaceAlt}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,4,0">
                                                        <DockPanel>
                                                            <TextBlock Text="CLEAN (0 Hooks)" Foreground="#D6FF3F" FontSize="10" FontFamily="JetBrains Mono, Consolas" DockPanel.Dock="Right"/>
                                                            <TextBlock Text="Process Hook Integrity" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="10"/>
                                                        </DockPanel>
                                                    </Border>
                                                    <Border Background="{DynamicResource Theme.SurfaceAlt}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="4,4,0,0">
                                                        <DockPanel>
                                                            <TextBlock Text="AES-256-GCM" Foreground="{DynamicResource Theme.TextPrimary}" FontSize="10" FontFamily="JetBrains Mono, Consolas" DockPanel.Dock="Right"/>
                                                            <TextBlock Text="Telemetry Storage" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="10"/>
                                                        </DockPanel>
                                                    </Border>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Recent Audit Stream -->
                                        <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="AUDIT STREAM (RECENT)" Foreground="{DynamicResource Theme.TextPrimary}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                                <TextBlock Text="09:07:16.102  [SYS]   Oasyss Flux core engine initialized" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="10" FontFamily="JetBrains Mono, Consolas" Margin="0,2"/>
                                                <TextBlock Text="09:07:16.140  [AFFN]  Display affinity set: WDA_EXCLUDEFROMCAPTURE" Foreground="{DynamicResource Theme.TextPrimary}" FontSize="10" FontFamily="JetBrains Mono, Consolas" Margin="0,2"/>
                                                <TextBlock Text="09:07:16.188  [AUTH]  Local workspace bound to user: Divyesh" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="10" FontFamily="JetBrains Mono, Consolas" Margin="0,2"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- VIEW 2: SESSIONS (The Browser Overlay Workspace) -->
                                <Grid x:Name="PanelSessions" Visibility="Visible">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Tabs Row -->
                                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                        <!-- Chrome Top Window Controls (Visible ONLY in Browser Mode) -->
                                        <StackPanel x:Name="ChromeTopControls" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="8,0,0,0">
                                            <!-- Ask Gemini Pill Button -->
                                            <Button x:Name="BtnAskGemini" Style="{StaticResource ChromeGeminiButtonStyle}" Margin="0,0,10,0" ToolTip="Ask Gemini (AI Mode Tab)">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="✨" Margin="0,0,6,0" FontSize="12" Foreground="#4285F4"/>
                                                    <TextBlock Text="Ask Gemini" FontSize="11" FontWeight="Medium" Foreground="#E8EAED"/>
                                                </StackPanel>
                                            </Button>
                                            <!-- Chrome Minimize Button -->
                                            <Button x:Name="ChromeMinimizeBtn" Style="{StaticResource ChromeWindowButtonStyle}" ToolTip="Minimize" Width="38" Height="30">
                                                <TextBlock Text="&#x2014;" FontSize="11" Foreground="#9AA0A6" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Button>
                                            <!-- Chrome FullScreen / Maximize Button (ONLY in Browser Mode!) -->
                                            <Button x:Name="ChromeMaximizeBtn" Style="{StaticResource ChromeWindowButtonStyle}" ToolTip="Full Screen / Maximize" Width="38" Height="30">
                                                <TextBlock x:Name="ChromeMaximizeIcon" Text="&#x25A2;" FontSize="13" Foreground="#9AA0A6" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Button>
                                            <!-- Chrome Close Button -->
                                            <Button x:Name="ChromeCloseBtn" Style="{StaticResource ChromeWindowCloseButtonStyle}" ToolTip="Close" Width="40" Height="30">
                                                <TextBlock Text="&#x2715;" FontSize="11" Foreground="#9AA0A6" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>

                                        <Button x:Name="NewTabButton" DockPanel.Dock="Right" Margin="4,0,0,0" Style="{StaticResource ChromeTabstripButtonStyle}" ToolTip="New Tab (Ctrl+T)">
                                            <TextBlock Text="+" FontSize="16" Foreground="#9AA0A6" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                        </Button>
                                        <TabPanel x:Name="HeaderPanel" 
                                                  IsItemsHost="true" 
                                                  Margin="2,0,0,0" 
                                                  ZIndex="1"
                                                  AllowDrop="True"
                                                  DragOver="HeaderPanel_DragOver"
                                                  Drop="HeaderPanel_Drop" />
                                    </DockPanel>

                                    <!-- Navigation Row -->
                                    <DockPanel Grid.Row="1" Margin="0,0,0,6">
                                        <Button x:Name="BackButton" Style="{StaticResource ChromeNavButtonStyle}" Margin="0,0,2,0" ToolTip="Click to go back">
                                            <TextBlock Text="&#x2190;" FontSize="13" Foreground="#9AA0A6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <Button x:Name="ForwardButton" Style="{StaticResource ChromeNavButtonStyle}" Margin="0,0,4,0" ToolTip="Click to go forward">
                                            <TextBlock Text="&#x2192;" FontSize="13" Foreground="#9AA0A6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <Grid Width="28" Height="28" Margin="0,0,6,0">
                                            <Button x:Name="RefreshButton" Style="{StaticResource ChromeNavButtonStyle}" ToolTip="Reload this page">
                                                <TextBlock Text="&#x21BB;" FontSize="15" Foreground="#9AA0A6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <Image x:Name="LoadingSpinner" Source="./loading.png"
                                                   Style="{StaticResource LoadingSpinnerStyle}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Visibility="Collapsed"
                                                   Height="18"/>
                                        </Grid>
                                        <Border Background="#202124" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="14" Height="30">
                                            <Grid>
                                                <TextBox x:Name="AddressBar"
                                                         VerticalContentAlignment="Center"
                                                         Padding="28,0,10,0"
                                                         Background="Transparent"
                                                         Foreground="#E8EAED"
                                                         BorderThickness="0"
                                                         CaretBrush="#8AB4F8"
                                                         Height="28"
                                                         FontSize="12"/>
                                                <TextBlock Text="🔍"
                                                           Foreground="#9AA0A6"
                                                           IsHitTestVisible="False"
                                                           VerticalAlignment="Center"
                                                           Margin="9,0,0,0"
                                                           FontSize="11"/>
                                                <TextBlock Text="Search Google or type a URL"
                                                           Foreground="#9AA0A6"
                                                           IsHitTestVisible="False"
                                                           VerticalAlignment="Center"
                                                           Margin="28,0,0,0"
                                                           FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=AddressBar}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DockPanel>

                                    <!-- Toolbar Row -->
                                    <Border x:Name="BrowserToolbarBorder" Grid.Row="2" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6" Padding="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                <ItemsControl x:Name="BookmarksBar" ItemsSource="{Binding Bookmarks}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type local:Bookmark}">
                                                            <Button Click="Bookmark_Click" 
                                                                    MouseRightButtonUp="Bookmark_RightClick" 
                                                                    Style="{StaticResource ModernButtonStyle}" 
                                                                    Margin="2,0" 
                                                                    Padding="5,3">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Image Source="{Binding Favicon}" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="90" VerticalAlignment="Center" FontSize="11"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <!-- Cyber Tools (Flux Mode Only) -->
                                            <StackPanel x:Name="CyberToolbarTools" Grid.Column="1" Orientation="Horizontal">
                                                <Button x:Name="AddBookmarkButton" 
                                                        Width="26" 
                                                        Height="26" 
                                                        Style="{StaticResource ModernButtonStyle}"
                                                        Click="AddBookmarkButton_Click">
                                                    <Image Source="./plus.png" Height="16"/>
                                                </Button>

                                                <!-- AI Chat Toggle Button -->
                                                <Button x:Name="AiChatButton" Style="{StaticResource ModernButtonStyle}" Width="28" Height="26" Margin="4,0,0,0" ToolTip="Open AI Chat">
                                                    <TextBlock Text="AI" FontSize="10" FontWeight="SemiBold" FontFamily="JetBrains Mono, Consolas" Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Button>

                                                <!-- Transparency Toggle Button + Slider Popup -->
                                                <StackPanel Orientation="Vertical" Margin="4,0,0,0">
                                                    <Button x:Name="TransparencyButton" Style="{StaticResource ModernButtonStyle}" Width="32" Height="26" ToolTip="Toggle Transparency (Shift+T / Shift+Alt+T)">
                                                        <TextBlock Text="CLR" FontSize="9" FontWeight="SemiBold" FontFamily="JetBrains Mono, Consolas" Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Button>
                                                    <Border x:Name="TransparencySliderPopup" 
                                                            Visibility="Collapsed" 
                                                            Background="{DynamicResource Theme.Surface}" 
                                                            BorderBrush="{DynamicResource Theme.Border}" 
                                                            BorderThickness="1" 
                                                            CornerRadius="4" 
                                                            Padding="5" 
                                                            Margin="0,2,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="Opacity" Foreground="{DynamicResource Theme.TextMuted}" FontSize="9" HorizontalAlignment="Center"/>
                                                            <Slider x:Name="TransparencySliderControl" 
                                                                    Minimum="0.1" Maximum="1.0" Value="0.5" 
                                                                    Width="80" 
                                                                    Margin="0,3,0,0"/>
                                                            <Button x:Name="GhostModeButton" Content="Ghost (100%)" 
                                                                    Style="{StaticResource DialogButtonStyle}" 
                                                                    FontSize="9" Padding="4,2" Margin="0,4,0,0" 
                                                                    ToolTip="Make completely transparent &amp; click-through (Shift+T / Shift+Alt+T)"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <Button x:Name="SettingsButton" Style="{StaticResource ModernButtonStyle}" Width="26" Height="26" Margin="4,0,0,0" Click="SettingsButton_Click">
                                                    <Image Source="./settings.png" Height="16" VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Content Row (WebView2 & AI Chat) -->
                                    <Border Grid.Row="3"
                                            BorderBrush="{DynamicResource Theme.Border}"
                                            BorderThickness="1"
                                            Background="Transparent"
                                            Padding="0"
                                            CornerRadius="4">
                                        <Grid>
                                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                                            <Border x:Name="WebViewPlaceholder"
                                                    Background="#08090B"
                                                    Opacity="0.5"
                                                    CornerRadius="4"
                                                    Visibility="Collapsed" />
                                            <!-- AI Chat Panel Host -->
                                            <Grid x:Name="AiChatHost" Visibility="Visible" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- VIEW 3: ANALYSIS -->
                                <ScrollViewer x:Name="PanelAnalysis" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Style="{StaticResource DarkThinScrollViewerStyle}">
                                    <StackPanel Margin="6,0,6,6">
                                        <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <DockPanel>
                                                <Button x:Name="BtnRunVerification" DockPanel.Dock="Right" Content="RUN VERIFICATION" Style="{StaticResource DialogButtonStyle}" FontSize="10" Padding="12,4"/>
                                                <StackPanel>
                                                    <TextBlock Text="ANALYSIS" Foreground="{DynamicResource Theme.TextPrimary}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Text="AUTHORIZED SECURITY RESEARCH" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="10" FontFamily="JetBrains Mono, Consolas" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <UniformGrid Columns="2" Margin="0,0,0,8">
                                            <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="TARGET" Foreground="{DynamicResource Theme.TextMuted}" FontSize="9" FontFamily="JetBrains Mono, Consolas"/>
                                                    <TextBox Text="proc://auth_broker.dll" Style="{StaticResource DialogTextBoxStyle}" Margin="0,4,0,8"/>
                                                    <TextBlock Text="ENVIRONMENT" Foreground="{DynamicResource Theme.TextMuted}" FontSize="9" FontFamily="JetBrains Mono, Consolas"/>
                                                    <TextBox Text="x64 Ring-3 Monitored Sandbox" Style="{StaticResource DialogTextBoxStyle}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="4,0,0,0">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,8">
                                                        <TextBlock Text="PID 10948 (flux_core.exe)" Foreground="{DynamicResource Theme.TextPrimary}" FontSize="10" FontFamily="JetBrains Mono, Consolas" DockPanel.Dock="Right"/>

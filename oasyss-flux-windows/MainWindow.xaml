                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="IPC: 127.0.0.1:49152" Foreground="{DynamicResource Theme.TextMuted}" FontSize="9" FontFamily="JetBrains Mono, Consolas" Margin="0,0,10,0"/>

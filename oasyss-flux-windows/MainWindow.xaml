                                    <TextBlock Text="AFFINITY: WDA_EXCLUDEFROMCAPTURE" Foreground="#D6FF3F" FontSize="9" FontFamily="JetBrains Mono, Consolas"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
        </TabControl>
    </Border>
</Window>
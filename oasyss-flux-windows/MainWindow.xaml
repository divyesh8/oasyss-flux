                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- Telemetry Data Table -->
                                        <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">

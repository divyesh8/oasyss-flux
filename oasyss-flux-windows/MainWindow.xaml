                                    <TextBlock Text="00:14:32" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="9" FontFamily="JetBrains Mono, Consolas"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Fill="#D6FF3F" Margin="0,0,6,0" VerticalAlignment="Center"/>
